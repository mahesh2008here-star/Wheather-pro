# Farm Weather Application Environment Variables Configuration
# Copy this file to .env for local environment configuration

# 1. Open-Meteo Weather API Endpoint (Public & Free - NO API KEY REQUIRED)
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
VITE_REVERSE_GEOCODE_API_URL=https://api.bigdatacloud.net/data/reverse-geocode-client

# 2. Server-Side Google Gemini API Key (Optional - Auto-injected by AI Studio)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Backend Feedback Target Recipient Email (Optional - Defaults to Developer Email)
# Used by Express server endpoint (POST /api/feedback)
FEEDBACK_GMAIL=mmmmahe46@gmail.com
