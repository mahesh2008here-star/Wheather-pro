<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Android Home Screen: 1. Farm Weather Full Scene -->
        <receiver
            android:name=".WeatherHouseWidgetProvider"
            android:label="Farm Weather Scene"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_house_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget A. Compact Current Weather -->
        <receiver
            android:name=".WeatherCompactWidgetProvider"
            android:label="Farm Weather: Compact Weather"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_compact_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget B. Hourly Forecast Strip -->
        <receiver
            android:name=".WeatherForecastWidgetProvider"
            android:label="Farm Weather: Hourly Forecast"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_forecast_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget C. Seven-Day Outlook -->
        <receiver
            android:name=".WeatherSevenDayWidgetProvider"
            android:label="Farm Weather: 7-Day Outlook"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_sevenday_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget D. Farm Field Conditions -->
        <receiver
            android:name=".WeatherFarmWidgetProvider"
            android:label="Farm Weather: Field Telemetry"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_farm_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget E. Rain & Irrigation Outlook -->
        <receiver
            android:name=".WeatherIrrigationWidgetProvider"
            android:label="Farm Weather: Irrigation Outlook"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_irrigation_widget_info" />
        </receiver>

        <!-- Android Home Screen: Widget F. Air Quality & UV -->
        <receiver
            android:name=".WeatherAirUvWidgetProvider"
            android:label="Farm Weather: Air Quality &amp; UV"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_air_uv_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
