<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_farm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_green"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌱 Farm Field Telemetry"
            android:textColor="#171717"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_farm_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parcel"
            android:textColor="#159B69"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2x2 Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Topsoil (0-1cm)"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_soil_moisture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42% moist"
                android:textColor="#159B69"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_soil_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soil: 21°C"
                android:textColor="#737873"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precipitation"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_rain_prob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15% prob"
                android:textColor="#1687C9"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_rain_sum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sum: 0.0 mm"
                android:textColor="#737873"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Field Wind"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 km/h W"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_gust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gust: 20 km/h"
                android:textColor="#737873"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Moisture"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68% RH"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_farm_dew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dew: 17°C"
                android:textColor="#737873"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
