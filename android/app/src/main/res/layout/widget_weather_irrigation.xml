<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_irrigation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_blue"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌧️ Rain &amp; Irrigation Outlook"
            android:textColor="#171717"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_irrig_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_live_green"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Optimal"
            android:textColor="#159B69"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 Metrics Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expected Rain"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_irrig_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 mm"
                android:textColor="#1687C9"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_irrig_prob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15% prob"
                android:textColor="#737873"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ET₀ Loss"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_irrig_et0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.2 mm/d"
                android:textColor="#F57C00"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moderate"
                android:textColor="#737873"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_surface_white"
            android:padding="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Field Wind"
                android:textColor="#737873"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_irrig_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 km/h"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe spray"
                android:textColor="#159B69"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Planning Advisory -->
    <TextView
        android:id="@+id/widget_irrig_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/chip_bg_green"
        android:padding="6dp"
        android:text="Advisory: Favorable conditions for normal irrigation schedule."
        android:textColor="#171717"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
