<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_forecast_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_white"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_forecast_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm Weather"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_forecast_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partly Cloudy • Feels 23°"
                android:textColor="#737873"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_forecast_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="#F57C00"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4-Period Hourly Forecast Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/chip_bg_neutral"
            android:padding="4dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now"
                android:textColor="#737873"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h1_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10%"
                android:textColor="#1687C9"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/chip_bg_neutral"
            android:padding="4dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1h"
                android:textColor="#737873"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h2_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15%"
                android:textColor="#1687C9"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/chip_bg_neutral"
            android:padding="4dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+2h"
                android:textColor="#737873"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h3_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30%"
                android:textColor="#1687C9"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/chip_bg_neutral"
            android:padding="4dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3h"
                android:textColor="#737873"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h4_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h4_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45%"
                android:textColor="#1687C9"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
