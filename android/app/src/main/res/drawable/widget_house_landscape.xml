<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sky Background Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E3A8A"
                android:centerColor="#2563EB"
                android:endColor="#60A5FA" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Rolling Hills / Field Layer -->
    <item android:top="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#15803D"
                android:endColor="#166534" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>

    <!-- Frosted Glass Overlay for Content Legibility -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#20000000"
                android:endColor="#DD090D16" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
